BASE_DIR = Path(__file__).resolve().parent
ZIP_PATH = BASE_DIR / "archive.zip"
DATA_DIR = BASE_DIR

if ZIP_PATH.exists():
    extracted_dir = BASE_DIR / "fake_news_dataset"
    extracted_dir.mkdir(exist_ok=True)

    with zipfile.ZipFile(ZIP_PATH, "r") as zip_ref:
        zip_ref.extractall(extracted_dir)

    DATA_DIR = extracted_dir

TRUE_PATH = DATA_DIR / "True.csv"
FAKE_PATH = DATA_DIR / "Fake.csv"

if not TRUE_PATH.exists() or not FAKE_PATH.exists():
    raise FileNotFoundError(
        "Dataset files not found. Place True.csv and Fake.csv "
        "beside this script, or place archive.zip containing them "
        "in the same folder."
    )
